# Copy to .env and fill in real values. Never commit .env itself.

# ANTHROPIC_API_KEY is required -- claude-haiku-4-5 is the SMOKE-tier default for
# agent-llm/user-llm (see Makefile). Free tiers (Gemini, Groq) were tried first but
# turned out too rate/quota-limited for real iteration -- see PLAN.md commit 3 notes.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Points tau2-bench at its own domain/task data. Set by `make install` to the vendored
# checkout it clones -- override only if you know what you're doing.
TAU2_DATA_DIR=./vendor/tau2-bench/data

# tau2's CLI prints unicode (checkmarks etc.); without this, Windows consoles on a
# non-UTF-8 codepage crash with UnicodeEncodeError. No-op on macOS/Linux.
PYTHONUTF8=1
